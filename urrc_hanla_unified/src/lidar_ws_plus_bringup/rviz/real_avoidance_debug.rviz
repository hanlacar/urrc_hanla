Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 28; 28; 32
    Fixed Frame: base_link
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Vehicle Grid
      Enabled: true
      Plane: XY
      Cell Size: 0.5
      Color: 90; 90; 90
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Frame Timeout: 15
      Marker Scale: 0.25
      Show Arrows: true
      Show Axes: true
      Show Names: true
    - Class: rviz_default_plugins/LaserScan
      Name: Raw Front LaserScan
      Enabled: true
      Topic:
        Value: /front/scan
      Style: Points
      Size (Pixels): 3
      Color: 255; 255; 255
      Decay Time: 0
    - Class: rviz_default_plugins/Marker
      Name: Planner ROI Boundary
      Enabled: true
      Topic:
        Value: /avoidance/debug/roi
    - Class: rviz_default_plugins/Marker
      Name: Planner ROI Points
      Enabled: true
      Topic:
        Value: /avoidance/debug/roi_points
    - Class: rviz_default_plugins/Marker
      Name: ROI Rejected Points
      Enabled: true
      Topic:
        Value: /avoidance/debug/rejected_points
    - Class: rviz_default_plugins/MarkerArray
      Name: Obstacle Tracks And Labels
      Enabled: true
      Topic:
        Value: /avoidance/debug/obstacles
    - Class: rviz_default_plugins/MarkerArray
      Name: Selected Obstacle
      Enabled: true
      Topic:
        Value: /avoidance/debug/selected_obstacle
    - Class: rviz_default_plugins/MarkerArray
      Name: Collision Prediction
      Enabled: true
      Topic:
        Value: /avoidance/debug/collision
    - Class: rviz_default_plugins/Path
      Name: Reference Route
      Enabled: true
      Topic:
        Value: /avoidance/route/reference_path
      Line Style: Lines
      Line Width: 0.05
      Color: 0; 120; 255
    - Class: rviz_default_plugins/MarkerArray
      Name: Candidate Avoidance Paths
      Enabled: true
      Topic:
        Value: /avoidance/candidate_paths
    - Class: rviz_default_plugins/Path
      Name: Selected Avoidance Path
      Enabled: true
      Topic:
        Value: /avoidance/selected_path
      Line Style: Lines
      Line Width: 0.10
      Color: 255; 0; 255
    - Class: rviz_default_plugins/Marker
      Name: Safe Corridor
      Enabled: true
      Topic:
        Value: /avoidance/corridor_marker
    - Class: rviz_default_plugins/MarkerArray
      Name: Planning Geometry
      Enabled: true
      Topic:
        Value: /avoidance/planning_points
    - Class: rviz_default_plugins/Marker
      Name: Planner Status Text
      Enabled: true
      Topic:
        Value: /avoidance/planner_status_marker
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 10
      Focal Point:
        X: 3.0
        Y: 0.0
        Z: 0.0
      Pitch: 0.75
      Yaw: 3.14
Window Geometry:
  Width: 1440
  Height: 900
