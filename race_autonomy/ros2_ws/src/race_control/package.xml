<?xml version="1.0"?>
<package format="3">
  <name>race_control</name>
  <version>0.1.0</version>
  <description>Pure Pursuit path tracking for the race vehicle.</description>
  <maintainer email="maintainer@example.com">urrc_hanla</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>race_perception</exec_depend>
  <exec_depend>race_vehicle_interface</exec_depend>
  <exec_depend>race_interfaces</exec_depend>
  <exec_depend>camera_navigation</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
